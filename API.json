    {
      "name": "Get Weather (Open-Meteo)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.open-meteo.com/v1/forecast?latitude=12.97&longitude=77.59&current_weather=true",
          "protocol": "https",
          "host": ["api", "open-meteo", "com"],
          "path": ["v1", "forecast"],
